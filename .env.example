# OpenRouter gives access to every model behind one key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides. Defaults are free-tier models so the project runs at zero cost.
# DEFLECTOR_ANSWERER=openai/gpt-oss-20b:free
# DEFLECTOR_VERIFIER=inclusionai/ling-3.0-flash:free
# DEFLECTOR_EMBEDDER=openai/text-embedding-3-small

# Set to any value to replay only from .cache/llm (no network, fully reproducible)
# DEFLECTOR_OFFLINE=1
# Set to any value to bypass the response cache
# DEFLECTOR_NO_CACHE=1
